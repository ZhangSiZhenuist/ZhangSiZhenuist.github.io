---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import SkywayBlog from "@/components/SkywayBlog";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPath } from "@/utils/getPath";
import "@/styles/skyway.css";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const homepagePosts = sortedPosts.map(({ id, data, filePath }) => ({
  title: data.title,
  description: data.description,
  href: getPath(id, filePath),
  date: data.pubDatetime.toISOString(),
  tags: data.tags,
}));
---

<Layout title="章思哲｜技术、学习与真实思考">
  <SkywayBlog client:load posts={homepagePosts} />
</Layout>
